# Sentinel .gitignore — secrets and scratch never get committed

# Secrets / keys — NEVER commit
.env
.env.*
*.pem
*.key
**/*secret*
**/*credentials*
kaggle.json
# BYOK integration key store — live PagerDuty/Jev keys live here at runtime.
# This repo goes public at Preview-1: a `git add -A` must NEVER be able to
# commit a live key (Vault finding on PR #77).
sentinel-state/
integrations.json

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache__/
*.egg-info/
.eggs/

# Node (docs tooling, if ever)
node_modules/

# SQLite dev databases (audit store runs locally; the file is not the schema)
*.db
*.sqlite
*.sqlite3
sentinel.db

# Local runtime scratch
/tmp/
*.log
.DS_Store

# deploy lane: generated bundles, never committed
deploy/dist/
deploy/dist-data/

# R-10 drill lab: rebuilt from scratch by env-bootstrap.sh every drill
# cycle (devops-foundation.md §1.1); never committed.
staging-lab/
